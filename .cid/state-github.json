    "Nightly": {
      "version": "0.11.13",
      "name": "Nightly",
      "name_slug": "nightly",
      "job_timeout": 20,
      "default_branch": "master",
      "container_runtime": "podman",
      "workflow_key": "nightly",
      "workflow_config": {
        "type": "nightly",
        "trigger_manual": true,
        "trigger_cron": true,
        "trigger_cron_schedule": "27 0 * * 0",
        "trigger_schedule_branches": [
          "master",
          "develop"
        ],
        "environment_pattern": "nightly-.*"
      },
      "network_global": [
        "keyserver.ubuntu.com:443",
        "github.com:443",
        "api.github.com:443",
        "codeload.github.com:443",
        "uploads.github.com:443",
        "objects.githubusercontent.com:443",
        "raw.githubusercontent.com:443",
        "release-assets.githubusercontent.com:443",
        "ghcr.io:443",
        "pkg-containers.githubusercontent.com:443"
      ],
      "plan": {
        "name": "main",
        "stages": [
          "build",
          "test",
          "scan"
        ],
        "steps": [
          {
            "id": "0",
            "name": "gradle-build [twitch4j]",
            "slug": "gradle-build-twitch4j",
            "stage": "build",
            "scope": "module",
            "action": "builtin://actions/gradle-build",
            "module": "gradle-build-gradle-kts",
            "module-dir": ".",
            "access": {
              "env": [
                {
                  "name": "WRAPPER_VERIFICATION"
                }
              ],
              "executables": [
                {
                  "name": "java",
                  "constraint": "\u003e= 21.0.0-0"
                }
              ],
              "network": [
                "repo.maven.apache.org:443",
                "repo1.maven.org:443",
                "kotlinlang.org:443",
                "plugins.gradle.org:443",
                "plugins-artifacts.gradle.org:443",
                "services.gradle.org:443",
                "downloads.gradle.org:443",
                "jcenter.bintray.com:443",
                "javadoc.io:443",
                "www.javadocs.dev:443"
              ]
            },
            "inputs": {},
            "outputs": {},
            "order": 0
          },
          {
            "id": "1",
            "name": "gradle-test [twitch4j]",
            "slug": "gradle-test-twitch4j",
            "stage": "test",
            "scope": "module",
            "action": "builtin://actions/gradle-test",
            "module": "gradle-build-gradle-kts",
            "module-dir": ".",
            "access": {
              "executables": [
                {
                  "name": "java",
                  "constraint": "\u003e= 21.0.0-0"
                }
              ],

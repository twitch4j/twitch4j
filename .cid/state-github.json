            "inputs": {},
            "outputs": {
              "artifacts": [
                {
                  "type": "report",
                  "format": "sarif"
                },
                {
                  "type": "report",
                  "format": "jacoco"
                },
                {
                  "type": "report",
                  "format": "junit"
                }
              ]
            },
            "order": 1
          },
          {
            "id": "2",
